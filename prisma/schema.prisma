// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  role      Role
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  student   Student?
  faculty   Faculty?
  hod       Hod?
  director  Director?
}

model Student {
  id              String           @id @default(uuid())
  rollNumber      String           @unique
  name            String
  email           String           @unique
  year            Int
  department      String
  branch          String?
  section         String?
  session         String?          // e.g. "2023-2027", "2022-2026"
  course          String?          // e.g. "B.Tech", "B.Sc"
  semester        Int?             @default(1) // Current active semester (1-8 for B.Tech, 1-6 for B.Sc)
  image           String?
  cgpa            Float?           @default(0.0)
  attendance      Float?           @default(0.0)
  status          String?          @default("Active")
  userId          String?          @unique
  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  attendances     Attendance[]
  studentSubjects StudentSubject[]
  results         Result[]

  @@index([department, session])
  @@index([course, session, year])
}

model Faculty {
  id          String       @id @default(uuid())
  employeeId  String       @unique
  name        String
  email       String       @unique
  department  String
  designation String?      @default("Assistant Professor")
  status      String?      @default("Active")
  experience  Int?         @default(0)
  image       String?
  userId      String?      @unique
  user        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendances Attendance[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Hod {
  id          String   @id @default(uuid())
  employeeId  String   @unique
  name        String
  email       String   @unique
  department  String
  userId      String?  @unique
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Director {
  id          String   @id @default(uuid())
  employeeId  String   @unique
  name        String
  email       String   @unique
  userId      String?  @unique
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Attendance {
  id           String           @id @default(uuid())
  studentId    String
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId    String?
  subject      Subject?         @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  facultyId    String?
  faculty      Faculty?         @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  date         DateTime
  timeSlot     String?          // e.g. "09:00-10:00", "10:00-11:00"
  branch       String?
  department   String?
  section      String?
  status       AttendanceStatus
  isSubmitted  Boolean          @default(false)
  submittedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([date])
  @@index([branch, department, date])
  @@index([facultyId, date])
  @@index([studentId, date])
}

model Course {
  id             String            @id @default(uuid())
  code           String            @unique // e.g., "BTECH", "BSC", "BCA", "MCA"
  name           String            // e.g., "Bachelor of Technology", "Bachelor of Science"
  durationYears  Int               @default(4) // e.g. 4 for B.Tech, 3 for B.Sc
  totalSemesters Int               @default(8) // e.g. 8 for B.Tech, 6 for B.Sc
  department     String?           // Default department or null for multi-dept
  description    String?
  status         String?           @default("Active")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  sessions       AcademicSession[]
  subjects       Subject[]
}

model AcademicSession {
  id              String           @id @default(uuid())
  sessionName     String           // e.g. "2023-2027", "2022-2026", "2024-2028"
  startYear       Int              // e.g. 2023
  endYear         Int              // e.g. 2027
  courseId        String?
  course          Course?          @relation(fields: [courseId], references: [id], onDelete: SetNull)
  courseCode      String?          // e.g. "B.Tech", "B.Sc"
  totalSemesters  Int              @default(8) // derived from degree (e.g. 8 for B.Tech, 6 for B.Sc)
  currentSemester Int?             @default(1)
  status          String?          @default("Active") // "Active", "Completed", "Upcoming"
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  studentSubjects StudentSubject[]

  @@unique([sessionName, courseCode])
  @@index([sessionName])
}

model Subject {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  department  String
  branch      String?
  credits     Int              // Academic Credits (starts at 0)
  year        Int
  semester    Int
  type        String?          @default("Core") // "Core", "Elective", "Lab", "Project"
  status      String?          @default("Active") // "Active", "Inactive"
  courseId    String?
  course      Course?          @relation(fields: [courseId], references: [id], onDelete: SetNull)
  courseName  String?          @default("B.Tech") // e.g. "B.Tech", "B.Sc"
  createdAt   DateTime         @default(now())

  studentSubjects StudentSubject[]
  assignments     Assignment[]
  results         Result[]
  attendances     Attendance[]

  @@index([department, semester])
  @@index([branch, semester])
  @@index([courseName, semester])
}

model StudentSubject {
  id              String           @id @default(uuid())
  studentId       String
  student         Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId       String
  subject         Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  semester        Int              @default(1) // Semester for which subject is opted (1 to 8)
  session         String           @default("2023-2027") // Academic session e.g. "2023-2027", "2022-2026"
  department      String?          // e.g. "Computer Science & Engineering (CSE)"
  course          String?          @default("B.Tech") // e.g. "B.Tech", "B.Sc"
  academicYear    String?          // e.g. "2023-2024"
  isOpted         Boolean          @default(true)
  status          String?          @default("Enrolled") // "Enrolled", "Completed", "Dropped"
  optedAt         DateTime         @default(now())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt @default(now())

  sessionId       String?
  academicSession AcademicSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@unique([studentId, subjectId, semester, session])
  @@index([studentId, semester])
  @@index([department, semester, session])
  @@index([session, semester])
  @@index([subjectId])
}

model Assignment {
  id          String   @id @default(uuid())
  title       String
  description String
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  dueDate     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Result {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  internal  Int
  external  Int
  total     Int
  grade     String
  points    Float
  createdAt DateTime @default(now())
}

model Notice {
  id        String   @id @default(uuid())
  title     String
  content   String
  role      Role
  createdAt DateTime @default(now())
}

enum Role {
  STUDENT
  FACULTY
  HOD
  DIRECTOR
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

model CurriculumPlan {
  id             String   @id @default(uuid())
  schemeName     String
  department     String
  academicYear   String
  totalCredits   Int      @default(160)
  semestersCount Int      @default(8)
  regulations    String
  status         String   @default("Active") // "Active" | "Draft" | "Archived"
  pdfUrl         String?  // optional PDF attachment
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt @default(now())

  @@index([department, status])
  @@index([academicYear])
}

model Syllabus {
  id          String   @id @default(uuid())
  code        String   @unique
  subject     String
  department  String
  semester    Int
  units       Int      @default(5)
  totalHours  Int      @default(45)
  docUrl      String?
  status      String   @default("Active") // "Active" | "Under Review"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())

  @@index([department, semester])
  @@index([status])
}
